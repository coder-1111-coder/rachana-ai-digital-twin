# Copy to .env and fill in. .env is git-ignored. NEVER commit a real key.

# Required for the Digital Twin. Get one at https://console.groq.com/keys
# Without it the site still works; /api/twin/chat returns 503 twin_not_configured.
GROQ_API_KEY=

# Optional (invalid values are rejected with a warning at startup, never silently misread)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # must be https (http only for localhost)
# PORT=8787
# HOST=127.0.0.1                # 0.0.0.0 to expose beyond this machine
# TRUST_PROXY=1                 # set when behind ONE reverse proxy, so rate limits see real client IPs
# TWIN_RATE_LIMIT_PER_MIN=20    # per client (IPv6 clients are grouped by /64)
# TWIN_GLOBAL_LIMIT_PER_HOUR=300  # site-wide ceiling on questions that reach Groq
# TWIN_TIMEOUT_MS=15000
